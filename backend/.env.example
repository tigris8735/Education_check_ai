# --- App ---
APP_NAME=Education_check_ai
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (Neon) ---
# ВАЖНО: asyncpg требует префикс postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# --- JWT ---
JWT_SECRET=change_me_to_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- S3 (Cloudflare R2 / AWS) ---
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_BUCKET=education-check-ai
S3_PRESIGN_EXPIRE=3600

# --- Files ---
MAX_FILE_SIZE_MB=20

# --- AI ---
AI_PROVIDER=mock          # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Redis (для ARQ на Render) ---
REDIS_URL=redis://default:password@host:port